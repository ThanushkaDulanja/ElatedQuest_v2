NODE_ENV=development
PORT=3000
# Public HTML cache is off by default in development; set on to override.
# PAGE_CACHE=off
SITE_URL=http://127.0.0.1:3001
# Add both callbacks to this OAuth client’s Authorized redirect URIs in Google Cloud:
# ${SITE_URL}/auth/google/callback (sign-in) and ${SITE_URL}/api/admin/blogger/callback (Blogger).

DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=elatedquest_app
DB_PASSWORD=CHANGE_ME
DB_NAME=elatedquest
DB_TEST_NAME=elatedquest_m0_test

SESSION_SECRET=CHANGE_ME_TO_A_LONG_RANDOM_VALUE
HASH_SECRET=CHANGE_ME_TO_A_LONG_RANDOM_VALUE
OWNER_EMAIL=owner@example.com

GOOGLE_CLIENT_ID=CHANGE_ME.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=CHANGE_ME

SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=CHANGE_ME
SMTP_PASS=CHANGE_ME
EMAIL_FROM="ElatedQuest <noreply@example.com>"
SUBMISSIONS_EMAIL=stories@example.com
CONTACT_EMAIL=contact@example.com

ENCRYPTION_KEY=CHANGE_ME_WITH_A_BASE64_ENCODED_32_BYTE_KEY
UPLOAD_DIR=./uploads
UPLOADS_PUBLIC_URL=http://127.0.0.1:3001/uploads

SENTRY_DSN=
PLAUSIBLE_DOMAIN=
BACKUP_DIR=./backups
# Must point to separate durable storage (for example a mounted backup volume).
BACKUP_SECONDARY_DIR=
