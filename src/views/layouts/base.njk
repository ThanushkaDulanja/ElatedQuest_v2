<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <meta name="description" content="{{ description or 'Stories from ElatedQuest.' }}">
    <title>{% block title %}ElatedQuest{% endblock %}</title>
    <link rel="stylesheet" href="/css/site.css">
    <script type="module" src="/js/main.js"></script>
  </head>
  <body>
    <header class="site-header">
      <a href="/" aria-label="ElatedQuest home">ElatedQuest</a>
    </header>
    <main class="site-main" id="main-content">
      {% block content %}{% endblock %}
    </main>
    <footer class="site-footer">
      <p>ElatedQuest</p>
    </footer>
  </body>
</html>
