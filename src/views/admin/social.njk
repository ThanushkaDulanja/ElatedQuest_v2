<!doctype html>
<html lang="en">
  <head><meta charset="utf-8"><meta name="viewport" content="width=device-width, initial-scale=1"><meta name="robots" content="noindex,nofollow"><title>{{ title }} · ElatedQuest Admin</title><link rel="stylesheet" href="/css/site.css"></head>
  <body class="admin-shell">
    <header class="admin-header"><a class="admin-brand" href="/aadmin">ElatedQuest Admin</a><div class="admin-header__account"><span>{{ user.display_name or user.email }}</span><form action="/auth/sign-out" method="post"><input type="hidden" name="_csrf" value="{{ csrfToken }}"><button class="btn btn--secondary btn--small" type="submit">Sign out</button></form></div></header>
    <div class="admin-layout">{% include "admin/_sidebar.njk" %}<main class="admin-main">
      <div class="admin-page__heading"><div><p><a href="/aadmin/settings">Settings</a></p><h1>Social links and menus</h1><p>These links update the public header, connected panel and footer.</p></div></div>
      <section class="admin-panel"><h2>Social links</h2><form method="post" action="/api/admin/settings/social-links"><input type="hidden" name="_csrf" value="{{ csrfToken }}"><div class="table-wrap"><table class="data-table"><thead><tr><th>Platform</th><th>Label</th><th>Profile URL</th><th>Followers label</th><th>Top bar</th><th>Footer</th><th>Stay connected</th><th>Active</th></tr></thead><tbody>
      {% for row in socialRows %}<tr><td><input name="platform_{{ loop.index0 }}" maxlength="30" value="{{ row.platform or '' }}" aria-label="Platform {{ loop.index }}"></td><td><input name="label_{{ loop.index0 }}" maxlength="60" value="{{ row.label or '' }}" aria-label="Social label {{ loop.index }}"></td><td><input name="url_{{ loop.index0 }}" maxlength="500" value="{{ row.url or '' }}" aria-label="Profile URL {{ loop.index }}"></td><td><input name="followers_{{ loop.index0 }}" maxlength="20" value="{{ row.followers_label or '' }}" aria-label="Follower label {{ loop.index }}"></td><td><input type="checkbox" name="top_{{ loop.index0 }}" {% if row.show_in_top_bar %}checked{% endif %} aria-label="Show in top bar"></td><td><input type="checkbox" name="footer_{{ loop.index0 }}" {% if row.show_in_footer %}checked{% endif %} aria-label="Show in footer"></td><td><input type="checkbox" name="connected_{{ loop.index0 }}" {% if row.show_in_stay_connected %}checked{% endif %} aria-label="Show in Stay connected"></td><td><input type="checkbox" name="active_{{ loop.index0 }}" {% if row.is_active or not row.platform %}checked{% endif %} aria-label="Active"></td></tr>{% endfor %}
      </tbody></table></div><p class="field__help">Use a lowercase platform key such as facebook, instagram, pinterest, x, youtube or tiktok. Empty URLs hide the link publicly.</p><button class="btn btn--primary" type="submit">Save social links</button></form></section>
      <section class="admin-panel"><h2>Menus</h2><form method="post" action="/api/admin/settings/menus"><input type="hidden" name="_csrf" value="{{ csrfToken }}"><div class="table-wrap"><table class="data-table"><thead><tr><th>Location</th><th>Label</th><th>URL</th><th>Active</th><th>Open in new tab</th></tr></thead><tbody>
      {% for row in menuRows %}<tr><td><select name="location_{{ loop.index0 }}" aria-label="Menu location {{ loop.index }}"><option value="">—</option><option value="top"{% if row.location == 'top' %} selected{% endif %}>Top</option><option value="header"{% if row.location == 'header' %} selected{% endif %}>Header</option><option value="footer"{% if row.location == 'footer' %} selected{% endif %}>Footer</option></select></td><td><input name="menu_label_{{ loop.index0 }}" maxlength="80" value="{{ row.label or '' }}" aria-label="Menu label {{ loop.index }}"></td><td><input name="menu_url_{{ loop.index0 }}" maxlength="500" value="{{ row.url or '' }}" aria-label="Menu URL {{ loop.index }}"></td><td><input type="checkbox" name="menu_active_{{ loop.index0 }}" {% if row.is_active or not row.label %}checked{% endif %} aria-label="Menu item active"></td><td><input type="checkbox" name="menu_newtab_{{ loop.index0 }}" {% if row.open_in_new_tab %}checked{% endif %} aria-label="Open menu in new tab"></td></tr>{% endfor %}
      </tbody></table></div><button class="btn btn--primary" type="submit">Save menus</button></form></section>
    </main></div>
  </body>
</html>
