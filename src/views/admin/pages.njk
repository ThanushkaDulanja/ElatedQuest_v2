<!doctype html><html lang="en"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width, initial-scale=1"><meta name="robots" content="noindex,nofollow"><title>Static pages · ElatedQuest Admin</title><link rel="stylesheet" href="/css/site.css"></head><body class="admin-shell"><header class="admin-header"><a class="admin-brand" href="/aadmin">ElatedQuest Admin</a><div class="admin-header__account"><span class="role-badge role-badge--owner">Admin</span><span>{{ user.display_name or user.email }}</span></div></header><div class="admin-layout">{% include "admin/_sidebar.njk" %}<main class="admin-main"><div class="admin-page__heading"><h1>Static pages</h1><p>Edit public policy and information pages.</p></div><div class="table-wrap"><table class="admin-table"><thead><tr><th>Page</th><th>Updated</th><th>Action</th></tr></thead><tbody>{% for page in pages %}<tr><td>{{ page.title }}</td><td>{{ page.updated_at }}</td><td><a class="btn btn--secondary btn--small" href="/aadmin/pages/{{ page.slug }}">Edit</a></td></tr>{% else %}<tr><td colspan="3">No seeded pages found. Run database/seed.sql.</td></tr>{% endfor %}</tbody></table></div></main></div></body></html>
