<!doctype html>
<html lang="en"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width, initial-scale=1"><meta name="robots" content="noindex,nofollow"><title>Posts · ElatedQuest Admin</title><link rel="stylesheet" href="/css/site.css"></head>
<body class="admin-shell"><header class="admin-header"><a class="admin-brand" href="/aadmin">ElatedQuest Admin</a><div class="admin-header__account"><span class="role-badge role-badge--{{ user.role }}">{{ user.role | roleLabel }}</span><span>{{ user.display_name or user.email }}</span><form action="/auth/sign-out" method="post"><input type="hidden" name="_csrf" value="{{ csrfToken }}"><button class="btn btn--secondary btn--small" type="submit">Sign out</button></form></div></header><div class="admin-layout">{% include "admin/_sidebar.njk" %}<main class="admin-main"><div class="admin-page__heading"><h1>Posts</h1><form action="/aadmin/posts/new" method="post"><input type="hidden" name="_csrf" value="{{ csrfToken }}"><button class="btn btn--primary" type="submit">+ New post</button></form></div>
{% if query.published %}<p class="flash-message" role="status">Post published successfully.</p>{% if query.blogger_failed %}<p class="flash-message flash-message--error" role="alert">The post is live on this site, but Blogger synchronization failed. Open the post to review the sync error or retry.</p>{% endif %}{% elif query.scheduled %}<p class="flash-message" role="status">Post scheduled.</p>{% elif query.blogger_synced %}<p class="flash-message" role="status">Post synchronized to Blogger.</p>{% elif query.blogger_failed %}<p class="flash-message flash-message--error" role="alert">Blogger synchronization failed. Open the post to review the sync error.</p>{% elif query.blogger_disconnected %}<p class="flash-message flash-message--error" role="alert">Connect Blogger before synchronizing posts.</p>{% elif query.deleted %}<p class="flash-message" role="status">Draft deleted</p>{% elif query.changes_requested %}<p class="flash-message" role="status">Changes requested; post returned to draft.</p>{% endif %}
{% if user.role == 'owner' and blogger.needsReconnect %}<div class="flash-message flash-message--error" role="alert">Blogger needs to be reconnected. <a href="/aadmin/settings#blogger">Reconnect Blogger</a></div>{% elif user.role == 'owner' and blogger.failedCount %}<div class="flash-message flash-message--error" role="alert">{{ blogger.failedCount }} post{% if blogger.failedCount != 1 %}s{% endif %} failed to sync to Blogger. <form action="/api/admin/blogger/retry-failed" method="post" class="inline-form"><input type="hidden" name="_csrf" value="{{ csrfToken }}"><button class="btn btn--secondary btn--small" type="submit">Retry all</button></form></div>{% endif %}{% if query.blogger_retried %}<p class="flash-message" role="status">Blogger retries started.</p>{% endif %}{% if user.role == 'owner' and reviewCount %}<div class="review-banner">{{ reviewCount }} post{% if reviewCount != 1 %}s{% endif %} in review · <a href="/aadmin?status=in_review">Review now</a></div>{% endif %}
<section class="post-stat-grid" aria-label="Post statistics"><div class="post-stat"><span>Published</span><strong>{{ counts.published or 0 }}</strong></div><div class="post-stat"><span>In review</span><strong>{{ counts.in_review or 0 }}</strong></div><div class="post-stat"><span>Drafts</span><strong>{{ counts.drafts or 0 }}</strong></div><div class="post-stat"><span>Views · 7 days</span><strong>{{ counts.views or 0 }}</strong></div></section>
<div class="post-list-controls"><nav class="admin-tabs" aria-label="Post status">{% for label,value in [['All',''],['Draft','draft'],['In review','in_review'],['Scheduled','scheduled'],['Published','published'],['Archived','archived']] %}<a href="/aadmin?status={{ value }}{% if search %}&search={{ search | urlencode }}{% endif %}"{% if status == value %} aria-current="page"{% endif %}>{{ label }}</a>{% endfor %}</nav><form class="toolbar-row" method="get" action="/aadmin" data-feature="post-suggestions"><input type="hidden" name="status" value="{{ status }}"><input type="hidden" name="post_id" value="{{ postId or '' }}" data-selected-post><label class="visually-hidden" for="post-search">Search posts</label><div class="dashboard-search"><input id="post-search" type="search" name="search" placeholder="Search posts" value="{{ search }}" autocomplete="off" role="combobox" aria-autocomplete="list" aria-expanded="false" aria-controls="post-suggestions-list"><div id="post-suggestions-list" class="post-suggestions" role="listbox" hidden></div></div><button class="btn btn--primary btn--small" type="submit">Search</button></form></div>
<div class="table-wrap"><table class="admin-table posts-table"><thead><tr><th>Title</th><th>Author</th><th>Status</th><th>Blogger</th><th>Updated</th><th>Views (7 days)</th><th>Actions</th></tr></thead><tbody>{% for post in rows %}<tr><td><a href="/aadmin/posts/{{ post.id }}">{{ post.title }}</a></td><td>{{ post.author_name or '—' }}</td><td><span class="status-badge status-badge--{{ post.status }}">{{ post.status | replace('_',' ') | title }}</span></td><td aria-live="polite">{% if post.blogger_sync_status == 'synced' %}<a href="{{ post.blogger_url }}" target="_blank" rel="noopener">Synced</a>{% elif post.blogger_sync_status == 'pending' %}<span class="status-badge status-badge--pending">Syncing</span>{% elif post.blogger_sync_status == 'failed' %}<span class="status-badge status-badge--failed" title="{{ post.blogger_last_error }}">Failed</span>{% elif post.status != 'published' %}<span>—</span>{% elif blogger.connected %}<form action="/api/admin/posts/{{ post.id }}/retry-blogger" method="post" data-feature="blogger-sync"><input type="hidden" name="_csrf" value="{{ csrfToken }}"><button class="btn btn--secondary btn--small" type="submit">Sync now</button></form>{% else %}<span>Not connected</span>{% endif %}</td><td><time datetime="{{ post.updated_at.toISOString() if post.updated_at.toISOString else post.updated_at }}">{{ post.updated_at }}</time></td><td>{{ post.views }}</td><td class="post-actions"><div class="table-actions"><a class="btn btn--secondary btn--small" href="/aadmin/posts/{{ post.id }}">Edit</a><a class="btn btn--secondary btn--small" href="/aadmin/preview/{{ post.id }}" target="_blank" rel="noopener">Preview</a>{% if user.role == 'owner' and post.status == 'published' %}<form action="/api/admin/posts/{{ post.id }}/archive" method="post"><input type="hidden" name="_csrf" value="{{ csrfToken }}"><input type="hidden" name="expected_updated_at" value="{{ post.updated_at_input }}"><button class="btn btn--secondary btn--small" type="submit">Archive</button></form>{% endif %}{% if post.status == 'draft' %}<form action="/api/admin/posts/{{ post.id }}/delete" method="post"><input type="hidden" name="_csrf" value="{{ csrfToken }}"><input type="hidden" name="expected_updated_at" value="{{ post.updated_at_input }}"><button class="btn btn--danger btn--small" type="submit">Delete</button></form>{% endif %}</div></td></tr>{% else %}<tr><td colspan="7">No posts found.</td></tr>{% endfor %}</tbody></table></div>
<nav class="pagination" aria-label="Post pages">{% if page > 1 %}<a href="/aadmin?status={{ status }}&search={{ search | urlencode }}{% if postId %}&post_id={{ postId }}{% endif %}&page={{ page - 1 }}">Previous</a>{% endif %}<span>Page {{ page }} of {{ ((total - 1) // pageSize) + 1 if total else 1 }}</span>{% if page * pageSize < total %}<a href="/aadmin?status={{ status }}&search={{ search | urlencode }}{% if postId %}&post_id={{ postId }}{% endif %}&page={{ page + 1 }}">Next</a>{% endif %}</nav>{% include "partials/sentry.njk" %}<script type="module" src="/js/main.js"></script></main></div></body></html>

