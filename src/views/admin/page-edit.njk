<!doctype html><html lang="en"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width, initial-scale=1"><meta name="robots" content="noindex,nofollow"><title>{{ title }} · ElatedQuest Admin</title><link rel="stylesheet" href="/css/site.css"><link rel="stylesheet" href="/vendor/quill/quill.snow.css">{% include "partials/sentry.njk" %}</head><body class="admin-shell"><header class="admin-header"><a class="admin-brand" href="/aadmin">ElatedQuest Admin</a><div class="admin-header__account"><span class="role-badge role-badge--owner">Admin</span><span>{{ user.display_name or user.email }}</span></div></header><div class="admin-layout">{% include "admin/_sidebar.njk" %}<main class="admin-main" data-feature="admin-page-editor"><div class="admin-page__heading"><h1>Edit {{ page.title }}</h1><p>Changes publish when saved. HTML is sanitized on the server.</p></div>{% if saved %}<p role="status">Page saved.</p>{% endif %}<form method="post" action="/aadmin/pages/{{ page.slug }}" class="page-editor-form"><input type="hidden" name="_csrf" value="{{ csrfToken }}"><label class="field">Title <input name="title" maxlength="160" required value="{{ page.title }}"></label><label class="field">Page content (HTML)<textarea name="content_html" data-page-content rows="24" maxlength="100000" required>{{ page.content_html }}</textarea><div class="quill-toolbar" data-page-toolbar hidden><span class="ql-formats"><button class="ql-bold" aria-label="Bold" type="button"></button><button class="ql-italic" aria-label="Italic" type="button"></button></span><span class="ql-formats"><select class="ql-header" aria-label="Heading"><option value="2">H2</option><option value="3">H3</option><option selected></option></select><button class="ql-blockquote" aria-label="Quote" type="button"></button></span><span class="ql-formats"><button class="ql-list" value="bullet" aria-label="Bulleted list" type="button"></button><button class="ql-list" value="ordered" aria-label="Numbered list" type="button"></button></span><span class="ql-formats"><button class="ql-link" aria-label="Link" type="button"></button></span></div><div class="page-quill" data-page-quill hidden></div></label><button class="btn btn--primary" type="submit">Save and publish</button> <a class="btn btn--secondary" href="/aadmin/pages">Cancel</a> <a class="btn btn--secondary" href="/{{ page.slug }}" target="_blank" rel="noopener">View page</a></form></main></div><script src="/vendor/quill/quill.js" defer></script><script type="module" src="/js/main.js"></script></body></html>
