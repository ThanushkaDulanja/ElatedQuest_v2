<!doctype html>
<html lang="en">
  <head><meta charset="utf-8"><meta name="viewport" content="width=device-width, initial-scale=1"><meta name="robots" content="noindex,nofollow"><title>{{ title }} · ElatedQuest Admin</title><link rel="stylesheet" href="/css/site.css"></head>
  <body class="admin-shell">
    <header class="admin-header"><a class="admin-brand" href="/aadmin">ElatedQuest Admin</a><div class="admin-header__account"><span>{{ user.display_name or user.email }}</span><form action="/auth/sign-out" method="post"><input type="hidden" name="_csrf" value="{{ csrfToken }}"><button class="btn btn--secondary btn--small" type="submit">Sign out</button></form></div></header>
    <div class="admin-layout">{% include "admin/_sidebar.njk" %}<main class="admin-main">
      <div class="admin-page__heading"><h1>Inbox · {{ tab | capitalize }}</h1><p>Review reader messages and story submissions.</p></div>
      <nav class="admin-tabs" aria-label="Inbox tabs"><a href="/aadmin/inbox?tab=comments">Comments</a><a href="/aadmin/inbox?tab=stories"{% if tab == 'stories' %} aria-current="page"{% endif %}>Stories</a>{% if user.role == 'owner' %}<a href="/aadmin/inbox?tab=messages"{% if tab == 'messages' %} aria-current="page"{% endif %}>Messages</a>{% endif %}</nav>
      {% if tab == 'stories' %}
        {% if stories.length %}<div class="table-wrap"><table class="data-table"><thead><tr><th>Story</th><th>Reader</th><th>Received</th><th>Actions</th></tr></thead><tbody>{% for story in stories %}<tr><td><strong>{{ story.title }}</strong><details><summary>Read submission</summary><p>{{ story.body_text }}</p>{% if story.links_text %}<p>Links: {{ story.links_text }}</p>{% endif %}</details></td><td>{{ story.name }}<br><a href="mailto:{{ story.email }}">{{ story.email }}</a></td><td>{{ story.created_at | formatDate("UTC") }}</td><td><div class="admin-action-row"><form method="post" action="/api/admin/submissions/{{ story.id }}/convert"><input type="hidden" name="_csrf" value="{{ csrfToken }}"><button class="btn btn--primary btn--small" type="submit">Convert to draft</button></form><form method="post" action="/api/admin/submissions/{{ story.id }}/reject"><input type="hidden" name="_csrf" value="{{ csrfToken }}"><button class="btn btn--secondary btn--small" type="submit">Reject</button></form><form method="post" action="/api/admin/submissions/{{ story.id }}/spam"><input type="hidden" name="_csrf" value="{{ csrfToken }}"><button class="btn btn--danger btn--small" type="submit">Spam</button></form></div></td></tr>{% endfor %}</tbody></table></div>{% else %}<p class="empty-state">No new story submissions.</p>{% endif %}
      {% else %}
        {% if messages.length %}<div class="table-wrap"><table class="data-table"><thead><tr><th>Message</th><th>Reader</th><th>Received</th><th>Status</th><th>Actions</th></tr></thead><tbody>{% for message in messages %}<tr><td><strong>{{ message.subject or 'No subject' }}</strong><details><summary>Read message</summary><p>{{ message.message }}</p></details></td><td>{{ message.name }}<br><a href="mailto:{{ message.email }}">{{ message.email }}</a></td><td>{{ message.created_at | formatDate("UTC") }}</td><td>{{ message.status }}</td><td><div class="admin-action-row"><a class="btn btn--primary btn--small" href="mailto:{{ message.email }}?subject=Re%3A%20{{ message.subject | urlencode }}">Reply by email</a>{% for status in ['read','replied','spam'] %}<form method="post" action="/api/admin/messages/{{ message.id }}/{{ status }}"><input type="hidden" name="_csrf" value="{{ csrfToken }}"><button class="btn btn--secondary btn--small" type="submit">{{ status | capitalize }}</button></form>{% endfor %}</div></td></tr>{% endfor %}</tbody></table></div>{% else %}<p class="empty-state">No contact messages.</p>{% endif %}
      {% endif %}
    </main></div>
  </body>
</html>
