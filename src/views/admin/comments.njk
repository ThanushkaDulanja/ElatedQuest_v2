<!doctype html>
<html lang="en">
  <head><meta charset="utf-8"><meta name="viewport" content="width=device-width, initial-scale=1"><meta name="robots" content="noindex,nofollow"><title>Comments · ElatedQuest Admin</title><link rel="stylesheet" href="/css/site.css"></head>
  <body class="admin-shell">
    <header class="admin-header"><a class="admin-brand" href="/aadmin">ElatedQuest Admin</a><div class="admin-header__account"><span>{{ user.display_name or user.email }}</span><form action="/auth/sign-out" method="post"><input type="hidden" name="_csrf" value="{{ csrfToken }}"><button class="btn btn--secondary btn--small" type="submit">Sign out</button></form></div></header>
    <div class="admin-layout">{% include "admin/_sidebar.njk" %}<main class="admin-main">
      <div class="admin-page__heading"><h1>Comments</h1><p>Review reader comments and reply to approved comments.</p></div>
      <nav class="admin-tabs" aria-label="Inbox tabs"><a href="/aadmin/inbox?tab=comments" aria-current="page">Comments</a><a href="/aadmin/inbox?tab=stories">Stories</a>{% if user.role == 'owner' %}<a href="/aadmin/inbox?tab=messages">Messages</a>{% endif %}</nav>
      {% if comments.length %}<div class="table-wrap"><table class="data-table"><thead><tr><th>Comment</th><th>Post</th><th>Reader</th><th>Status</th><th>Received</th><th>Actions</th></tr></thead><tbody>
      {% for comment in comments %}<tr><td>{{ comment.body }}</td><td>{{ comment.post_title }}</td><td>{{ comment.author_name }}</td><td>{{ comment.status }}</td><td>{{ comment.created_at | formatDate("UTC") }}</td><td>
        {% if comment.status == "pending" %}<div class="admin-action-row"><form method="post" action="/api/admin/comments/{{ comment.id }}/approve"><input type="hidden" name="_csrf" value="{{ csrfToken }}"><button class="btn btn--primary btn--small" type="submit">Approve</button></form><form method="post" action="/api/admin/comments/{{ comment.id }}/spam"><input type="hidden" name="_csrf" value="{{ csrfToken }}"><button class="btn btn--secondary btn--small" type="submit">Spam</button></form><form method="post" action="/api/admin/comments/{{ comment.id }}/trash"><input type="hidden" name="_csrf" value="{{ csrfToken }}"><button class="btn btn--danger btn--small" type="submit">Trash</button></form></div>
        {% else %}<form method="post" action="/api/admin/comments/{{ comment.id }}/reply"><input type="hidden" name="_csrf" value="{{ csrfToken }}"><input type="hidden" name="postId" value="{{ comment.post_id }}"><label>Staff reply <textarea name="body" minlength="2" maxlength="2000" required></textarea></label><button class="btn btn--primary btn--small" type="submit">Reply</button></form>{% endif %}
      </td></tr>{% endfor %}</tbody></table></div>{% else %}<p class="empty-state">No comments yet.</p>{% endif %}
    </main></div>
  </body>
</html>
