<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <meta name="robots" content="noindex, nofollow">
    <title>Admin · ElatedQuest</title>
    <link rel="stylesheet" href="/css/site.css">
  </head>
  <body class="admin-shell">
    <header class="admin-header">
      <a class="admin-brand" href="/aadmin">ElatedQuest Admin</a>
      <div class="admin-account"><span class="role-badge role-badge--{{ user.role }}">{{ user.role | roleLabel }}</span><span>{{ user.display_name or user.email }}</span>
        <form action="/auth/sign-out" method="post"><input type="hidden" name="_csrf" value="{{ csrfToken }}"><button class="btn btn--secondary btn--small" type="submit">Sign out</button></form>
      </div>
    </header>
    <div class="admin-layout">{% include "admin/_sidebar.njk" %}<main class="admin-main" id="main-content"><div class="admin-page__heading"><h1>Dashboard</h1></div><p>Welcome to your studio.</p></main></div>
</body>
</html>
