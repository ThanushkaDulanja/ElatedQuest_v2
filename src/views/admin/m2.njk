<!doctype html>
<html lang="en">
<head><meta charset="utf-8"><meta name="viewport" content="width=device-width, initial-scale=1"><meta name="robots" content="noindex,nofollow"><title>{{ title }} · ElatedQuest Admin</title><link rel="stylesheet" href="/css/site.css">{% include "partials/sentry.njk" %}<script type="module" src="/js/main.js"></script></head>
<body class="admin-shell">
<header class="admin-header"><a class="admin-brand" href="/aadmin">ElatedQuest Admin</a><div class="admin-header__account"><span class="role-badge role-badge--{{ user.role }}">{{ user.role | roleLabel }}</span><span>{{ user.display_name or user.email }}</span><form action="/auth/sign-out" method="post"><input type="hidden" name="_csrf" value="{{ csrfToken }}"><button class="btn btn--secondary btn--small" type="submit">Sign out</button></form></div></header>
<div class="admin-layout">{% include "admin/_sidebar.njk" %}<main class="admin-main"><div class="admin-page__heading"><h1>{{ title }}</h1></div>{% if error %}<p class="flash-message flash-message--error" role="alert">{{ error }}</p>{% endif %}
{% if section == 'team' %}
<h2>Invite a Content Moderator</h2><form class="team-invite-form" action="/api/admin/team" method="post"><input type="hidden" name="_csrf" value="{{ csrfToken }}"><label class="field field--lg">Email <input type="email" name="email" required maxlength="190"></label><div class="form-actions"><button class="btn btn--primary" type="submit">Send invite</button></div></form>
<p>The Admin email is configured on the server.</p><div class="table-wrap"><table class="admin-table"><thead><tr><th>Email</th><th>Role</th><th>Status</th><th>Last sign-in</th><th>Actions</th></tr></thead><tbody><tr><td>{{ ownerEmail }}</td><td><span class="role-badge role-badge--owner">Admin</span></td><td><span class="status-badge status-badge--active">Active</span></td><td>—</td><td>Locked</td></tr>{% for row in rows %}<tr><td>{{ row.email }}</td><td><span class="role-badge role-badge--editor">Content Moderator</span></td><td><span class="status-badge status-badge--{{ row.status }}">{{ row.status | title }}</span></td><td>{{ row.last_login_display or 'Never signed in' }}</td><td><div class="table-actions">{% if row.status == 'disabled' %}<form action="/api/admin/team/{{ row.id }}/enable" method="post"><input type="hidden" name="_csrf" value="{{ csrfToken }}"><button class="btn btn--secondary btn--small" type="submit">Enable</button></form>{% else %}<form action="/api/admin/team/{{ row.id }}/disable" method="post"><input type="hidden" name="_csrf" value="{{ csrfToken }}"><button class="btn btn--secondary btn--small" type="submit">Disable</button></form>{% endif %}{% if row.status == 'invited' %}<form action="/api/admin/team/{{ row.id }}/resend" method="post"><input type="hidden" name="_csrf" value="{{ csrfToken }}"><button class="btn btn--secondary btn--small" type="submit">Resend invite</button></form>{% endif %}<form action="/api/admin/team/{{ row.id }}/remove" method="post"><input type="hidden" name="_csrf" value="{{ csrfToken }}"><button class="btn btn--danger btn--small" type="submit">Remove</button></form></div></td></tr>{% else %}<tr><td colspan="5" class="admin-empty-state">No Content Moderators yet.</td></tr>{% endfor %}</tbody></table></div><p><a href="/aadmin/team/authors">Manage authors</a></p>
{% elif section == 'profile' %}
<form action="/api/admin/profile" method="post" class="profile-form"><input type="hidden" name="_csrf" value="{{ csrfToken }}"><label class="field field--md">Display name <input name="display_name" maxlength="120" required value="{{ author.display_name if author else user.display_name or '' }}"></label><label class="field field--full">Short bio <textarea name="bio" maxlength="500">{{ author.bio if author else '' }}</textarea></label><div class="avatar-picker avatar-picker--compact" data-feature="media-picker"><label for="avatar-media-profile">Avatar image<select id="avatar-media-profile" name="avatar_media_id"><option value="">No avatar</option>{% for item in media %}<option value="{{ item.id }}"{% if author and author.avatar_media_id == item.id %} selected{% endif %}>{{ item.file_name }}{% if not item.alt_text %} — no alt{% endif %}</option>{% endfor %}</select></label><button class="btn btn--secondary btn--small" type="button" data-picker-open>Browse media</button>{% if author and author.avatar_media_id %}{% for item in media %}{% if item.id == author.avatar_media_id %}<img class="avatar-picker__preview" src="{{ item.url }}" alt="Current avatar preview">{% endif %}{% endfor %}{% endif %}<dialog class="media-picker-dialog" data-picker-dialog aria-label="Choose avatar"><button class="btn btn--secondary btn--small" type="button" data-picker-close>Close</button><div data-picker-grid></div></dialog></div><label class="form-check-row"><input type="checkbox" name="show_on_about" value="1" {% if author and author.show_on_about %}checked{% endif %}> Show on About page</label><button class="btn btn--primary" type="submit">Save profile</button></form>
{% elif section == 'authors' %}
<h2>Authors</h2>{% for author in authors %}<details><summary>{{ author.display_name }} — {% if author.is_guest %}Guest{% else %}Team member{% endif %}</summary><form action="/api/admin/authors/{{ author.id }}" method="post" class="author-edit-form"><input type="hidden" name="_csrf" value="{{ csrfToken }}"><div class="avatar-picker avatar-picker--compact" data-feature="media-picker"><label>Avatar image<select name="avatar_media_id"><option value="">No avatar</option>{% for item in media %}<option value="{{ item.id }}"{% if author.avatar_media_id == item.id %} selected{% endif %}>{{ item.file_name }}{% if not item.alt_text %} — no alt{% endif %}</option>{% endfor %}</select></label><button class="btn btn--secondary btn--small" type="button" data-picker-open>Browse media</button>{% if author.avatar_media_id %}{% for item in media %}{% if item.id == author.avatar_media_id %}<img class="avatar-picker__preview" src="{{ item.url }}" alt="Current avatar preview">{% endif %}{% endfor %}{% endif %}<dialog class="media-picker-dialog" data-picker-dialog aria-label="Choose avatar"><button class="btn btn--secondary btn--small" type="button" data-picker-close>Close</button><div data-picker-grid></div></dialog></div><label class="field field--md">Display name <input name="display_name" maxlength="120" required value="{{ author.display_name }}"></label><label class="field field--full">Bio <textarea name="bio" maxlength="500">{{ author.bio or '' }}</textarea></label><label class="form-check-row"><input type="checkbox" name="show_on_about" value="1" {% if author.show_on_about %}checked{% endif %}> Show on About page</label><button class="btn btn--primary" type="submit">Save author</button></form></details>{% endfor %}<h2>Create guest author</h2><form action="/api/admin/authors/guest" method="post" class="author-create-form"><input type="hidden" name="_csrf" value="{{ csrfToken }}"><label class="field field--md">Display name <input name="display_name" maxlength="120" required></label><label class="field field--full">Bio <textarea name="bio" maxlength="500"></textarea></label><label class="form-check-row"><input type="checkbox" name="show_on_about" value="1"> Show on About page</label><button class="btn btn--primary" type="submit">Create guest author</button></form>
{% elif section == 'settings' %}
{% set general = values.general or {} %}{% set comments = values.comments or {} %}{% set publish = values.editors_can_publish or {} %}{% set bloggerAutoSync = values.blogger_auto_sync or { value: true } %}
<nav class="admin-tabs" aria-label="Settings tabs"><a href="#general">General</a> <a href="#rules">Rules</a> <a href="/aadmin/settings/social">Social links and menus</a> <a href="/aadmin/settings/ads">Ads</a> <a href="#blogger">Blogger</a></nav>
<form class="settings-form" action="/api/admin/settings" method="post"><input type="hidden" name="_csrf" value="{{ csrfToken }}"><section class="settings-panel settings-panel--general" id="general"><h2>General</h2><label class="field field--lg">Site name <input name="siteName" maxlength="120" required value="{{ general.siteName or '' }}"></label><label class="field field--lg">Tagline <input name="tagline" maxlength="200" value="{{ general.tagline or '' }}"></label><label class="field field--lg">Default social image URL <input name="socialImage" maxlength="500" value="{{ general.socialImage or '' }}"></label><label class="field field--lg">Contact email <input type="email" name="contactEmail" maxlength="190" required value="{{ general.contactEmail or '' }}"></label><label class="field field--lg">Submissions email <input type="email" name="submissionsEmail" maxlength="190" required value="{{ general.submissionsEmail or '' }}"></label><label class="field field--md">Business name <input name="businessName" maxlength="160" value="{{ general.businessName or '' }}"></label><label class="field field--full">Address <textarea name="address" maxlength="1000">{{ general.address or '' }}</textarea></label><label class="field field--md">Time zone <input name="timezone" maxlength="80" required value="{{ general.timezone or 'UTC' }}"></label><label class="field field--full">Footer blurb <textarea name="footerBlurb" maxlength="500">{{ general.footerBlurb or '' }}</textarea></label></section><section class="settings-panel settings-panel--rules" id="rules"><h2>Rules</h2><label><input type="checkbox" name="editorsCanPublish" {% if publish.value %}checked{% endif %}> Content Moderators can publish</label><label class="field field--md">Comment moderation <select name="moderation"><option value="all" {% if comments.moderation == 'all' %}selected{% endif %}>All</option><option value="first_time" {% if comments.moderation == 'first_time' %}selected{% endif %}>First time</option><option value="none" {% if comments.moderation == 'none' %}selected{% endif %}>None</option></select></label><label class="field field--full">Blocklist words, one per line <textarea name="blocklist">{{ (comments.blocklist or []) | join('\n') }}</textarea></label><label class="field field--xs">Auto-close days (0 disables) <input type="number" name="closeAfterDays" min="0" max="3650" value="{{ comments.closeAfterDays or 0 }}"></label></section><section class="settings-panel settings-panel--blogger" id="blogger"><h2>Blogger</h2>{% if blogger.connected %}<p class="blogger-connection-status" role="status">Connected to blog {{ blogger.blogId }}.</p><form class="blogger-disconnect-form" action="/api/admin/blogger/disconnect" method="post"><input type="hidden" name="_csrf" value="{{ csrfToken }}"><button class="btn btn--secondary" type="submit">Disconnect Blogger</button></form>{% elif blogger.needsReconnect %}<p class="flash-message flash-message--error" role="alert">Blogger needs to be reconnected before posts can sync.</p><a class="btn btn--primary" href="/api/admin/blogger/connect">Reconnect Blogger</a>{% else %}<p>Blogger is not connected.</p><a class="btn btn--primary" href="/api/admin/blogger/connect">Connect Blogger</a>{% endif %}<label class="settings-check-row"><input type="checkbox" name="bloggerAutoSync" {% if bloggerAutoSync.value %}checked{% endif %}> Automatically sync posts when published</label><p class="field__help">Save settings to update automatic synchronization.</p></section><button class="btn btn--primary" type="submit">Save settings</button></form>
{% elif section == 'audit' %}
<div>
<form class="audit-filters" method="get" action="/aadmin/audit"><label class="field field--md">Actor <select name="actor"><option value="">All actors</option>{% for actor in audit.actors %}<option value="{{ actor.id }}" {% if filters.actor == actor.id|string %}selected{% endif %}>{{ actor.email }}</option>{% endfor %}</select></label><label class="field field--md">Action <select name="action"><option value="">All actions</option>{% for action in audit.actions %}<option {% if filters.action == action.action %}selected{% endif %}>{{ action.action }}</option>{% endfor %}</select></label><label class="field field--sm">From date <input type="date" name="from" aria-label="From date" value="{{ filters.fromIso }}"></label><label class="field field--sm">To date <input type="date" name="to" aria-label="To date" value="{{ filters.toIso }}"></label><button class="btn btn--primary btn--small" type="submit">Filter</button></form><p class="audit-timezone">Times shown in {{ audit.timeZone }} (24-hour clock).</p><div class="table-wrap"><table class="admin-table"><thead><tr><th>Time ({{ audit.timeZone }})</th><th>Actor</th><th>Action</th><th>Item</th><th>IP</th></tr></thead><tbody>{% for row in audit.rows %}<tr class="audit-row{% if row.action == 'auth.denied' or 'fail' in row.action %} audit-row--failed{% endif %}"><td>{{ row.created_at }}</td><td>{{ row.actor_email or 'Unknown' }}</td><td>{{ row.action }}</td><td>{{ row.entity_label }}</td><td>{{ row.ip or '' }}</td></tr>{% else %}<tr><td colspan="5" class="admin-empty-state">No audit events match these filters.</td></tr>{% endfor %}</tbody></table></div>
</div>
{% endif %}</main></div></body></html>



