<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <meta name="robots" content="noindex, nofollow">
    <title>Sign in · ElatedQuest</title>
    <link rel="stylesheet" href="/css/admin.css">
    <script type="module" src="/js/main.js"></script>
  </head>
  <body class="admin-login-page">
    <main class="admin-login" id="main-content" data-feature="admin-login">
      <a class="admin-brand" href="/">ElatedQuest</a>
      <h1>Sign in</h1>
      <a class="google-button" href="/auth/google" data-google-sign-in>Continue with Google</a>
      {% if googleMessage %}<p class="admin-message" role="alert">{{ googleMessage }}</p>{% endif %}
      <div class="login-divider" aria-hidden="true"><span>or</span></div>
      <form action="/auth/email" method="post" data-email-sign-in>
        <input type="hidden" name="_csrf" value="{{ csrfToken }}">
        <label for="email">Email address</label>
        <input id="email" name="email" type="email" autocomplete="email" required maxlength="190">
        <button type="submit">Email me a sign-in link</button>
      </form>
      {% if emailMessage %}<p class="admin-message" role="status">{{ emailMessage }}</p>{% endif %}
      <p class="admin-help">Trouble signing in? Try the other method.</p>
    </main>
  </body>
</html>
