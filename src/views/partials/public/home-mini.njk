<article class="public-home-mini">
  <a class="public-home-mini__image-link" href="/{{ post.slug }}" aria-label="Read {{ post.title }}">
    {% if post.cover_url %}<img data-card-image src="{{ post.cover_url }}"{% if post.cover_srcset %} srcset="{{ post.cover_srcset }}" sizes="96px"{% endif %} width="{{ post.cover_width or 800 }}" height="{{ post.cover_height or 450 }}" alt="{{ post.cover_alt or '' }}" loading="lazy">{% else %}<span class="public-card__placeholder" aria-hidden="true"></span>{% endif %}
  </a>
  <div class="public-home-mini__body"><h3><a href="/{{ post.slug }}">{{ post.title }}</a></h3><p>{% if post.published_at %}<time datetime="{{ post.published_at | dateIso }}">{{ post.published_at | formatDate(site.general.timezone) }}</time>{% endif %}</p></div>
</article>
