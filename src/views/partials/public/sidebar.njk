<aside class="public-sidebar" aria-label="More stories">
  {% if post and ads and ads.enabled and ads.slots.post_sidebar.enabled %}{% set adSlot = "post_sidebar" %}{% include "partials/public/ad-slot.njk" %}{% endif %}
  {% if site.stayConnected.length %}<section class="public-sidebar__block public-sidebar__block--connected"><h2>Stay connected</h2>{% for item in site.stayConnected %}<a class="public-connected-card public-connected-card--{{ item.platform }}" href="{{ item.href }}" target="_blank" rel="me noopener"><svg aria-hidden="true"><use href="/img/social-icons.svg#{{ item.icon }}"></use></svg><span><strong>{{ item.followers_label or item.label }}</strong><small>{{ item.label }}</small></span><b>{% if item.platform == "facebook" %}Like{% else %}Follow{% endif %}</b></a>{% endfor %}</section>{% elif isHomePage and isOwner %}<section class="public-sidebar__block public-sidebar__block--connected"><h2>Stay connected</h2><p class="public-sidebar__setup">Add verified social profiles in <a href="/aadmin/settings/social">Social links and menus</a>.</p></section>{% endif %}
  {% if isHomePage and ads and (ads.slots.home_sidebar.enabled or isOwner) %}<section class="public-home-promoted"><h2>Promoted content</h2>{% set adSlot = "home_sidebar" %}{% include "partials/public/ad-slot.njk" %}</section>{% endif %}
  {% if sidebar.editorPicks.length %}<section class="public-sidebar__block public-sidebar__block--editors"><h2>Editor picks</h2>{% for post in sidebar.editorPicks %}{% set sidebarRank = false %}{% include "partials/public/card-row.njk" %}{% endfor %}</section>{% endif %}
  {% if sidebar.popularPosts.length %}<section class="public-sidebar__block public-sidebar__block--popular" data-feature="popular-period" data-days="{{ popularDays or 7 }}"><h2>Popular posts</h2><nav class="public-popular-period" aria-label="Popular post period"><a href="/?popularDays=7#popular-posts" data-days="7"{% if popularDays != 30 %} aria-current="true"{% endif %}>7 days</a><a href="/?popularDays=30#popular-posts" data-days="30"{% if popularDays == 30 %} aria-current="true"{% endif %}>30 days</a></nav><div class="public-popular-period-results">{% for post in sidebar.popularPosts %}{% set sidebarRank = loop.index %}{% include "partials/public/card-row.njk" %}{% endfor %}</div></section>{% endif %}
  {% if sidebar.popularCategories.length %}<section class="public-sidebar__block public-sidebar__block--categories"><h2>Popular categories</h2><ul>{% for category in sidebar.popularCategories %}<li><a href="/category/{{ category.slug }}">{{ category.name }}</a><strong>{{ category.post_count }}</strong></li>{% endfor %}</ul></section>{% endif %}
</aside>
