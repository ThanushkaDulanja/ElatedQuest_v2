<article class="public-card-row{% if sidebarRank %} public-card-row--ranked{% endif %}"{% if sidebarRank %} data-rank="{{ sidebarRank }}"{% endif %}>
  <a class="public-card-row__image-link" href="/{{ post.slug }}" aria-label="Read {{ post.title }}">
    {% if post.cover_url %}<img data-card-image src="{{ post.cover_url }}"{% if post.cover_srcset %} srcset="{{ post.cover_srcset }}" sizes="{{ post.cover_sizes or '30vw' }}"{% endif %} width="{{ post.cover_width or 800 }}" height="{{ post.cover_height or 450 }}" alt="{{ post.cover_alt or '' }}" loading="lazy">{% else %}<span class="public-card__placeholder" aria-hidden="true"></span>{% endif %}
  </a>
  <div>{% if post.category_name %}<a class="public-card__category" href="/category/{{ post.category_slug }}">{{ post.category_name }}</a>{% endif %}<h2><a href="/{{ post.slug }}">{{ post.title }}</a></h2><p class="public-card__meta">{% if post.author_name %}{{ post.author_name }} · {% endif %}{% if post.published_at %}<time datetime="{{ post.published_at | dateIso }}">{{ post.published_at | formatDate(site.general.timezone) }}</time>{% endif %} · {{ post.view_count or 0 }} views · {{ post.comment_count or 0 }} comments</p>{% if post.excerpt %}<p class="public-card__excerpt">{{ post.excerpt }}</p>{% endif %}</div>
</article>
