<article class="public-home-card">
  <a class="public-home-card__image-link" href="/{{ post.slug }}" aria-label="Read {{ post.title }}">
    {% if post.cover_url %}<img data-card-image src="{{ post.cover_url }}"{% if post.cover_srcset %} srcset="{{ post.cover_srcset }}" sizes="(min-width: 1024px) 329px, (min-width: 640px) 50vw, 100vw"{% endif %} width="{{ post.cover_width or 800 }}" height="{{ post.cover_height or 450 }}" alt="{{ post.cover_alt or '' }}" loading="lazy">{% else %}<span class="public-card__placeholder" aria-hidden="true"></span>{% endif %}
  </a>
  <div class="public-home-card__body">
    <h3><a href="/{{ post.slug }}">{{ post.title }}</a></h3>
    <p class="public-home-card__meta">
      {% if post.category_name %}<a class="public-home-card__category" href="/category/{{ post.category_slug }}">{{ post.category_name }}</a>{% endif %}
      {% if post.author_name %}<span>{{ post.author_name }}</span>{% endif %}
      {% if post.published_at %}<time datetime="{{ post.published_at | dateIso }}">{{ post.published_at | formatDate(site.general.timezone) }}</time>{% endif %}
      <a class="public-home-card__comments" href="/{{ post.slug }}#comments" aria-label="{{ post.comment_count or 0 }} comments">{{ post.comment_count or 0 }}</a>
    </p>
    {% if post.excerpt %}<p class="public-home-card__excerpt">{{ post.excerpt }}</p>{% endif %}
  </div>
</article>
