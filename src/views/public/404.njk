{% extends "layouts/public.njk" %}
{% block content %}<section class="public-not-found"><p class="public-error-code">404</p><h1>We couldn't find that page</h1><form action="/search" method="get" role="search"><label for="not-found-query">Search stories</label><div><input id="not-found-query" type="search" name="q" placeholder="Search stories"><button type="submit">Search</button></div></form>{% if newest.length %}<h2>Latest stories</h2><div class="public-story-list">{% for post in newest %}{% include "partials/public/card-row.njk" %}{% endfor %}</div>{% endif %}</section>{% endblock %}
