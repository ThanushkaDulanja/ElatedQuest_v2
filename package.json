{
  "name": "elatedquest",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "^22.13.0 || >=24"
  },
  "scripts": {
    "start": "node server.js",
    "worker": "node worker.js",
    "migrate": "node src/db/migrate.js",
    "owner-link": "node scripts/owner-link.js",
    "dev:demo-posts": "node scripts/dev-demo-posts.js",
    "dev:demo-clean": "node scripts/dev-demo-clean.js",
    "build:css": "node scripts/build-css.js",
    "test:ui": "node scripts/ui-check.js",
    "vendor": "node scripts/vendor.js",
    "lint": "eslint .",
    "format:check": "prettier --check \"*.js\" \"*.json\" \"src/**/*.js\" \"scripts/**/*.js\" \"public/js/**/*.js\" \"public/css/**/*.css\"",
    "test": "node --test",
    "test:integration": "node --test tests/integration/admin-smoke.test.js",
    "test:e2e": "playwright test",
    "test:e2e:report": "playwright show-report"
  },
  "dependencies": {
    "@sentry/browser": "^11.11.0",
    "@sentry/node": "^11.11.0",
    "cookie-parser": "^1.4.7",
    "csrf-csrf": "^4.0.3",
    "express": "^5.3.0",
    "express-mysql-session": "^3.0.3",
    "express-session": "^1.19.0",
    "google-auth-library": "^11.3.4",
    "helmet": "^8.3.0",
    "multer": "^2.5.0",
    "mysql2": "^3.24.6",
    "node-cron": "^4.6.0",
    "nodemailer": "^10.3.1",
    "nunjucks": "^3.2.4",
    "quill": "^2.0.3",
    "sanitize-html": "^2.18.1",
    "sharp": "^0.35.5"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.0",
    "eslint": "^10.14.0",
    "playwright": "^1.65.0",
    "prettier": "^3.9.10"
  },
  "overrides": {
    "mysql2": "^3.24.6"
  }
}
